{
  "name": "warren",
  "description": "A long-running local agent that works in the background on your own computer",
  "homepage": "https://github.com/Nguxw/Warren#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nguxw/Warren.git"
  },
  "bugs": {
    "url": "https://github.com/Nguxw/Warren/issues"
  },
  "keywords": [
    "agent",
    "llm",
    "local-first",
    "sandbox",
    "bun",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "chaos": "bun evals/chaos/run.ts",
    "build": "bun build --compile --minify --sourcemap apps/cli/src/main.ts --outfile dist/warren"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
